{
  "name": "dsh-fatatalia-memory",
  "version": "1.0.0",
  "private": true,
  "description": "本地记忆库插件：用 SQLite + FTS5 trigram 保存 dsh 的全部原始对话，提供零 LLM 成本的历史检索与上下文读取工具（memory_search / memory_read 等 6 个）。2026-09-29 起取代 Hindsight 外部记忆服务。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": ">=3.18.0"
  }
}
